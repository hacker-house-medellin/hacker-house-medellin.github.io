---
import '../styles/global.css';
import VentureNetwork from '../components/VentureNetwork.astro';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A community operating layer for technical coliving, focused build weeks, coworking, events, and transparent resident operations in Medellín." />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href="https://hacker-house-medellin.github.io/" />
    <meta property="og:title" content="Hacker House Medellín" />
    <meta property="og:description" content="Live with builders. Leave with something shipped. Technical coliving and focused build weeks in Medellín." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hacker-house-medellin.github.io/" />
    <meta property="og:site_name" content="Hacker House Medellín" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Hacker House Medellín" />
    <meta name="twitter:description" content="Live with builders. Leave with something shipped. Technical coliving and focused build weeks in Medellín." />
    <meta name="theme-color" content="#14b8a6" />
    <link rel="icon" href="/favicon.svg" />
    <title>Hacker House Medellín — Live with builders. Ship with momentum.</title>
    <style is:global>
      .skip-link { position: fixed; top: 12px; left: 12px; z-index: 100; padding: 10px 14px; border-radius: 999px; background: #fff; color: #05070d; font-weight: 800; transform: translateY(-160%); transition: transform .18s ease; }
      .skip-link:focus { transform: translateY(0); }
      :focus-visible { outline: 3px solid var(--accent-2); outline-offset: 4px; }
      .status-chip { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 18px; padding: 8px 12px; border: 1px solid rgba(255,255,255,.14); border-radius: 999px; background: rgba(255,255,255,.07); color: rgba(248,250,252,.82); font-size: 13px; font-weight: 800; }
      .status-chip::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 18px var(--accent-2); }
      .site-footer { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; padding: 48px 0 12px; color: rgba(226,232,240,.64); font-size: 14px; }
      .site-footer p { max-width: 720px; margin: 0; font-size: 13px; }
      .footer-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; font-weight: 750; }
      .footer-links a:hover { color: #fff; }
      @media (max-width: 700px) { .site-footer { flex-direction: column; } .footer-links { justify-content: flex-start; } }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }
    </style>
  </head>
  <body style="--accent: #14b8a6; --accent-2: #a3e635;">
    <a class="skip-link" href="#content">Skip to content</a>
    <main id="content" class="page-shell">
      <nav class="nav" aria-label="Primary">
        <a class="brand" href="#top" aria-label="Hacker House Medellín home"><span class="brand-mark" aria-hidden="true"></span><span>Hacker House Medellín</span></a>
        <div class="nav-links"><a href="#platform">Platform</a><a href="#workflow">Workflow</a><a href="#principles">Principles</a><a href="#network">Network</a><a href="#contact" class="nav-cta">Early access</a></div>
      </nav>
      <section id="top" class="hero section-grid">
        <div class="hero-copy">
          <span class="status-chip">Early access</span>
          <p class="eyebrow">Medellín builder residency · early access</p>
          <h1>Live with builders. Leave with something shipped.</h1>
          <p class="hero-text">A warm, focused home base for engineers, founders, and creators—combining technical coliving, coworking, community rituals, and visible resident operations.</p>
          <div class="hero-actions"><a class="button primary" href="mailto:hello@hacker-house-medellin.com?subject=Hacker%20House%20Medell%C3%ADn%20build%20week">Apply for a build week</a><a class="button secondary" href="#workflow">Explore the experience</a></div>
          <div class="trust-row" aria-label="Product principles"><span>Build goals before arrival</span><span>Focus time and community in balance</span><span>Clear house operations for residents</span></div>
        </div>
        <aside class="hero-panel" aria-label="Product snapshot">
          <div class="pulse-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="stat-card"><strong>Build week</strong><span>a shared rhythm for focused progress</span></div>
          <div class="signal-list"><p>Designed for</p><h2>engineers, founders, open-source maintainers, creators, remote operators, and local community hosts</h2></div>
        </aside>
      </section>
      <section id="platform" class="platform">
        <div class="section-heading"><p class="eyebrow">Platform</p><h2>The structure of a residency, without the institutional feel.</h2><p>A shared operating layer helps hosts protect focus, welcome residents well, and keep the house running transparently.</p></div>
        <div class="feature-grid">
          <article class="feature-card"><span class="feature-dot"></span><h3>Resident journey</h3><p>Coordinate applications, goals, dates, room readiness, arrival details, deposits, community expectations, and checkout.</p></article>
          <article class="feature-card"><span class="feature-dot"></span><h3>Build-week rhythm</h3><p>Blend deep-work blocks, office hours, demos, shared meals, workshops, and optional city time without calendar chaos.</p></article>
          <article class="feature-card"><span class="feature-dot"></span><h3>House operations</h3><p>Make guest policy, quiet hours, maintenance, emergency contacts, access, and shared responsibilities easy to find.</p></article>
          <article class="feature-card"><span class="feature-dot"></span><h3>Community graph</h3><p>Help residents discover complementary skills, projects, interests, and alumni without turning community into a noisy feed.</p></article>
        </div>
      </section>
      <section id="workflow" class="workflow section-grid">
        <div><p class="eyebrow">Workflow</p><h2>Arrive with a goal. Leave with visible progress.</h2><p>The experience is organized around intent, compatible dates, protected focus, and a strong alumni loop.</p></div>
        <ol class="steps">
          <li><span>01</span><strong>Apply with a concrete build goal</strong></li>
          <li><span>02</span><strong>Match dates, room, desk, and community fit</strong></li>
          <li><span>03</span><strong>Set the week’s focus and collaboration rhythm</strong></li>
          <li><span>04</span><strong>Demo progress and share useful context</strong></li>
          <li><span>05</span><strong>Leave with an alumni path and next milestone</strong></li>
        </ol>
      </section>
      <section id="integrations" class="integrations"><div class="section-heading compact"><p class="eyebrow">Ecosystem</p><h2>Meet teams where their work already happens.</h2></div><div class="integration-marquee"><span>Google Calendar</span><span>Stripe</span><span>WhatsApp</span><span>Slack or Discord</span><span>Maps</span><span>Access logs</span></div></section>
      <section id="principles" class="architecture">
        <div class="arch-card large"><p class="eyebrow">Principles</p><h2>Community needs warmth and operational clarity.</h2><p>A great hacker house is neither a hotel nor an endless networking event. It is a safe, well-run environment where serious builders can focus and connect naturally.</p></div>
        <div class="arch-card"><strong>Focus is protected</strong><span>Shared norms, quiet blocks, and purposeful programming keep the residency useful for people doing difficult work.</span></div>
        <div class="arch-card"><strong>Operations are visible</strong><span>Residents can understand schedules, access, responsibilities, safety information, and changes without chasing a host.</span></div>
        <div class="arch-card"><strong>Local context matters</strong><span>The experience is designed with Medellín’s neighborhoods, culture, logistics, and builder community in mind.</span></div>
      </section>
      <VentureNetwork current="hacker-house-medellin" />
      <section id="contact" class="launch">
        <p class="eyebrow">Early access</p><h2>Plan a focused build week in Medellín.</h2><p>Share your project, preferred dates, working style, and what you hope to ship. Early applications will shape the first residency cohorts.</p>
        <div class="hero-actions" style="justify-content:center;"><a class="button primary" href="mailto:hello@hacker-house-medellin.com?subject=Hacker%20House%20Medell%C3%ADn%20build%20week">Apply for a build week</a><a class="button secondary" href="https://github.com/hacker-house-medellin" rel="me">Explore the GitHub organization</a></div>
      </section>
      <footer class="site-footer"><p>© {year} Hacker House Medellín. Residency details, availability, pricing, and house policies will be confirmed directly before any booking.</p><div class="footer-links"><a href="https://github.com/hacker-house-medellin">GitHub</a><a href="mailto:hello@hacker-house-medellin.com">Contact</a><a href="#top">Back to top</a></div></footer>
    </main>
  </body>
</html>
