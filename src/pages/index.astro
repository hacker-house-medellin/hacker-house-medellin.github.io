<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="Entrepreneur-focused coliving, coworking, and community operations in Medellín, Colombia." />
    <meta name="theme-color" content="#164d38" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://hacker-house-medellin.github.io/" />
    <meta property="og:title" content="Hacker House Medellín — A house that ships" />
    <meta property="og:description" content="Entrepreneur-focused coliving, coworking, and community operations in Medellín, Colombia." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hacker-house-medellin.github.io/" />
    <meta name="twitter:card" content="summary" />
    <title>Hacker House Medellín — A house that ships</title>
    <style>

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-width:320px}
a{color:inherit}
img,svg{max-width:100%;display:block}
button,input{font:inherit}
.skip{position:absolute;left:-9999px;top:0;z-index:1000;padding:.7rem 1rem;background:#fff;color:#000}
.skip:focus{left:1rem;top:1rem}
:focus-visible{outline:3px solid currentColor;outline-offset:4px}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}


:root{--concrete:#d7d1c4;--ink:#16201b;--green:#164d38;--orange:#e45b2f;--chalk:#f3efe5;--grid:rgba(22,32,27,.16)}
body{background:var(--concrete);color:var(--ink);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:28px 28px}
header{background:var(--chalk);border-bottom:4px solid var(--ink);display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:2rem;padding:1rem clamp(1rem,3vw,3rem);position:relative;z-index:3}.house-mark{width:42px;height:34px;border:3px solid var(--ink);border-top:0;position:relative}.house-mark:before{content:"";position:absolute;width:28px;height:28px;border-left:3px solid var(--ink);border-top:3px solid var(--ink);transform:rotate(45deg);left:4px;top:-15px}.brand{text-decoration:none;text-transform:uppercase;font-weight:900;letter-spacing:-.04em;font-size:clamp(1rem,2vw,1.5rem)}.city{color:var(--orange)}nav{display:flex;gap:1rem;font-size:.72rem;text-transform:uppercase}nav a{text-decoration:none;border-bottom:2px solid var(--ink)}
main{max-width:1500px;margin:auto;background:rgba(215,209,196,.88)}.hero{display:grid;grid-template-columns:1fr 1fr;min-height:78vh;border-bottom:4px solid var(--ink)}.hero-copy{padding:clamp(3rem,7vw,7rem) clamp(1rem,4vw,4rem);border-right:4px solid var(--ink);display:flex;flex-direction:column;justify-content:space-between;background:var(--green);color:var(--chalk)}.stamp{align-self:flex-start;border:2px solid currentColor;padding:.45rem .65rem;text-transform:uppercase;font-size:.68rem;transform:rotate(-2deg)}h1{font-family:Arial Black,Impact,sans-serif;font-size:clamp(4rem,9vw,9rem);line-height:.78;letter-spacing:-.07em;text-transform:uppercase;margin:3rem 0 1.5rem}.hero-copy p{font-family:Georgia,serif;font-size:clamp(1.15rem,2vw,1.8rem);line-height:1.45;max-width:29ch}.actions{display:flex;gap:.7rem;flex-wrap:wrap}.actions a{border:2px solid var(--chalk);padding:.75rem .9rem;text-decoration:none;text-transform:uppercase;font-size:.72rem}.actions a:first-child{background:var(--chalk);color:var(--green)}
.plan{padding:clamp(1rem,3vw,3rem);background:var(--chalk);display:grid;grid-template-columns:repeat(6,1fr);grid-template-rows:repeat(6,1fr);gap:8px;min-height:650px}.room{border:3px solid var(--ink);padding:.7rem;display:flex;flex-direction:column;justify-content:space-between;text-transform:uppercase;font-size:.68rem;background:rgba(255,255,255,.35)}.room strong{font-family:Arial,Helvetica,sans-serif;font-size:clamp(1.1rem,2vw,2rem);letter-spacing:-.05em}.room small{font-size:.62rem}.r1{grid-column:1/4;grid-row:1/3;background:#b9cbbf}.r2{grid-column:4/7;grid-row:1/4}.r3{grid-column:1/3;grid-row:3/6}.r4{grid-column:3/4;grid-row:3/6;background:var(--orange);color:white}.r5{grid-column:4/7;grid-row:4/6;background:#d9bd76}.r6{grid-column:1/7;grid-row:6/7;flex-direction:row;align-items:center;background:var(--ink);color:var(--chalk)}
.board{display:grid;grid-template-columns:1.1fr .9fr;border-bottom:4px solid var(--ink)}.day{padding:clamp(2rem,5vw,5rem);background:var(--chalk);border-right:4px solid var(--ink)}.day h2,.operating h2{font-family:Arial Black,Impact,sans-serif;font-size:clamp(2.8rem,6vw,6.5rem);line-height:.82;letter-spacing:-.06em;text-transform:uppercase;margin:0 0 2rem}.schedule{list-style:none;margin:0;padding:0}.schedule li{display:grid;grid-template-columns:5rem 1fr;padding:1rem 0;border-top:2px solid var(--ink);font-size:.82rem}.schedule time{font-weight:900;color:var(--orange)}.operating{padding:clamp(2rem,5vw,5rem);background:var(--orange);color:white}.operating dl{margin:0}.operating div{border-top:2px solid currentColor;padding:1rem 0}.operating dt{text-transform:uppercase;font-weight:900}.operating dd{margin:.4rem 0 0;font-family:Georgia,serif;line-height:1.5}
footer{background:var(--ink);color:var(--chalk);padding:1rem clamp(1rem,3vw,3rem);display:flex;justify-content:space-between;gap:1rem;text-transform:uppercase;font-size:.68rem}
@media(max-width:880px){header{grid-template-columns:auto 1fr}nav{display:none}.hero,.board{grid-template-columns:1fr}.hero-copy,.day{border-right:0;border-bottom:4px solid var(--ink)}.plan{min-height:520px}.schedule li{grid-template-columns:4rem 1fr}}

    </style>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>

    <header><span class="house-mark" aria-hidden="true"></span><a class="brand" href="#top">Hacker House <span class="city">Medellín</span></a><nav aria-label="Primary"><a href="#house">The house</a><a href="#day">A day</a><a href="https://github.com/hacker-house-medellin">Source</a></nav></header>
    <main id="content">
      <section class="hero" id="top"><div class="hero-copy"><span class="stamp">coliving + coworking + community</span><div><h1>A house<br/>that ships.</h1><p>Live with people building real companies, tools, art, and experiments—then still have a door to close when the workday ends.</p></div><div class="actions"><a href="https://github.com/hacker-house-medellin/hhm-api">Reservation API</a><a href="https://github.com/hacker-house-medellin/hacker-house-medellin.github.io">Site source</a></div></div>
        <div class="plan" id="house" aria-label="Illustrative house floor plan"><div class="room r1"><small>01 / street side</small><strong>Long table</strong><span>heads-down work</span></div><div class="room r2"><small>02 / courtyard</small><strong>Quiet rooms</strong><span>sleep is infrastructure</span></div><div class="room r3"><small>03 / shared</small><strong>Kitchen</strong><span>food, not networking theater</span></div><div class="room r4"><small>04</small><strong>Call<br/>booth</strong><span>close the door</span></div><div class="room r5"><small>05 / open air</small><strong>Roof lab</strong><span>demos · dinner · solder</span></div><div class="room r6"><strong>Medellín is outside the gate.</strong><span>walk it · learn it · contribute to it</span></div></div></section>
      <section class="board" id="day"><div class="day"><h2>Tuesday<br/>on the wall.</h2><ol class="schedule"><li><time>07:30</time><span>Quiet coffee. Nobody has to pitch anything.</span></li><li><time>10:00</time><span>Deep-work block; calls stay in the booths.</span></li><li><time>13:00</time><span>Shared lunch and a practical Spanish table.</span></li><li><time>17:30</time><span>Show one unfinished thing. Ask for one useful kind of help.</span></li><li><time>20:00</time><span>Open roof session with local builders and neighbors.</span></li></ol></div><div class="operating"><h2>Run the house, not a hype reel.</h2><dl><div><dt>Stays</dt><dd>Room type, dates, status, notes, and check-in state with a clear reservation boundary.</dd></div><div><dt>Work</dt><dd>Workspace plans, quiet hours, shared spaces, and enough operational structure to protect focus.</dd></div><div><dt>Community</dt><dd>Events and introductions are opt-in, practical, and connected to the city rather than replacing it.</dd></div></dl></div></section>
    </main>
    <footer><span>Medellín, Colombia</span><span>Entrepreneur-focused coliving and coworking</span></footer>


  </body>
</html>
